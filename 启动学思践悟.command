#!/bin/bash
# ==========================================================================
#  学思践悟 AI 多模态实训系统 · 新样式版
#  macOS 双击启动器
#
#  用法：在访达中双击本文件即可。
#        首次双击若提示「无法打开」，请在「系统设置 → 隐私与安全性」
#        中点击「仍要打开」，或右键选择「打开」。
#
#  本脚本会自动定位同目录下「微课系统/start.sh」，
#  因此整个文件夹解压到任何位置都能正常使用。
# ==========================================================================

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
START_SH="$SCRIPT_DIR/微课系统/start.sh"

echo ""
echo "  ╔══════════════════════════════════════════════════╗"
echo "  ║   学思践悟 · AI 多模态实训系统（新样式版）       ║"
echo "  ╚══════════════════════════════════════════════════╝"
echo ""

if [ ! -f "$START_SH" ]; then
  echo "  [错误] 找不到启动脚本："
  echo "         $START_SH"
  echo ""
  echo "  请确认「启动学思践悟.command」与「微课系统」文件夹"
  echo "  位于同一个目录下。"
  echo ""
  printf "  按回车键退出…"
  read -r _
  exit 1
fi

chmod +x "$START_SH" 2>/dev/null

cd "$SCRIPT_DIR" || exit 1
exec bash "$START_SH"

# 若因异常退出，保留窗口以便查看错误信息
echo ""
printf "  按回车键关闭窗口…"
read -r _
